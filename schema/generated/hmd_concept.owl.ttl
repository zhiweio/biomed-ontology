    skos:inScheme hmd:concept .

hmd:has_target a owl:DatatypeProperty ;
    rdfs:label "has_target" ;
    rdfs:range xsd:anyURI ;
    skos:definition "药物作用的靶点。与 parents 一样是概念之间的边，但它是**跨实体类型**的： parents 只在同类内部走（疾病→上位疾病），has_target 从 SUBSTANCE 跳到 TARGET。 检索期的 search-around 靠的就是这类跨类型跳转 —— 「VEGFR2 抑制剂」这种查询要从靶点反向找到药，层级扩展一步也走不到。" ;
    skos:inScheme hmd:concept .

hmd:members a owl:DatatypeProperty ;
    rdfs:label "members" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme hmd:concept .

hmd:parents a owl:DatatypeProperty ;
    rdfs:label "parents" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme hmd:concept .

hmd:treats a owl:DatatypeProperty ;
    rdfs:label "treats" ;
    rdfs:range xsd:anyURI ;
    skos:definition "药物的适应症。同为跨类型边（SUBSTANCE → DISEASE）。 与事实层同名谓词的区别在证据强度：这里是种子里的人工断言， 事实层那条是从正文抽出来、带 reifier 与出处的。两者落在不同命名图。" ;
    skos:inScheme hmd:concept .

<https://w3id.org/semapv/vocab/CompositeMatching> a owl:Class ;
    rdfs:label "CompositeMatching" ;
    rdfs:subClassOf hmd:MappingJustificationEnum ;
    skos:definition "组合匹配" .

<https://w3id.org/semapv/vocab/LexicalMatching> a owl:Class ;
    rdfs:label "LexicalMatching" ;
    rdfs:subClassOf hmd:MappingJustificationEnum ;
    skos:definition "词形匹配" .

<https://w3id.org/semapv/vocab/ManualMappingCuration> a owl:Class ;
    rdfs:label "ManualMappingCuration" ;
    rdfs:subClassOf hmd:MappingJustificationEnum ;
    skos:definition "人工审校" .

<https://w3id.org/semapv/vocab/MappingChaining> a owl:Class ;
    rdfs:label "MappingChaining" ;
    rdfs:subClassOf hmd:MappingJustificationEnum ;
    skos:definition "映射链传递（A=B, B=C 推出 A=C）" .

<https://w3id.org/semapv/vocab/SemanticSimilarityThresholdMatching> a owl:Class ;
    rdfs:label "SemanticSimilarityThresholdMatching" ;
    rdfs:subClassOf hmd:MappingJustificationEnum ;
    skos:definition "向量相似度过阈" .

<https://w3id.org/semapv/vocab/UnspecifiedMatching> a owl:Class ;
    rdfs:label "UnspecifiedMatching" ;
    rdfs:subClassOf hmd:MappingJustificationEnum ;
    skos:definition "来源未声明依据" .

hmd:RestoreScopeEnum a owl:Class ;
    rdfs:label "RestoreScopeEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/RestoreScopeEnum#SECTION> <https://w3id.org/asliva/biomed-ontology/RestoreScopeEnum#SIBLINGS> <https://w3id.org/asliva/biomed-ontology/RestoreScopeEnum#DOCUMENT> ) ;
    skos:definition "引用还原的范围。碎片能证明\"有这句话\"，但证明不了\"在什么语境下说的\"， 而临床结论的语境（哪一组、哪个终点、哪次随访）恰恰决定它是否成立。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/RestoreScopeEnum#DOCUMENT>,
        <https://w3id.org/asliva/biomed-ontology/RestoreScopeEnum#SECTION>,
        <https://w3id.org/asliva/biomed-ontology/RestoreScopeEnum#SIBLINGS> .

hmd:alias_id a owl:DatatypeProperty ;
    rdfs:label "alias_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^HMDA:\\d{9}$" ] ) ] ) ] ;
    skos:definition "别名条目的稳定 ID。可观测埋点回传的就是这个 ID —— 归因排障时要能从一条错误结论定位到具体哪一行别名（Demo 场景 4）。" ;
    skos:inScheme hmd:concept .

