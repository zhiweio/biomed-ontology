@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hmd: <https://w3id.org/asliva/biomed-ontology/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix oio: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hmd:Clique a owl:Class ;
    rdfs:label "Clique" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:built_by_justification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:built_by_justification ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:MappingJustificationEnum ;
            owl:onProperty hmd:built_by_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:conflict_flags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:conflict_flags ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:members ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:members ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:primary_xref ] ;
    skos:definition "等价团：一组通过 exact_match 互相连通的外部 ID 集合，对应唯一一个内部概念。 建团用连通分量算法，冲突（同团内出现两个来自同一权威源的不同 ID）进人工队列。" ;
    skos:inScheme hmd:concept .

hmd:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:parents ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:modified_in_release ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:equivalent_xrefs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:has_target ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:treats ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:modified_in_release ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:modified_in_release ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:consider ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:EntityTypeEnum ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:parents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:is_obsolete ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:equivalent_xrefs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:has_target ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:treats ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:is_obsolete ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:consider ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hmd:is_obsolete ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LicenseTierEnum ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:category ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:primary_xref ] ;
    owl:hasKey ( hmd:primary_xref ) ;
    skos:definition "一个生物医药概念的唯一锚点。所有别名、外部 ID、抽取事实、索引条目都挂在这个 ID 上。 ID 单调递增、永不复用；废弃走 replaced_by / consider 而不是删除。" ;
    skos:exactMatch skos:Concept ;
    skos:inScheme hmd:concept .

hmd:Hierarchy a owl:Class ;
    rdfs:label "Hierarchy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:parent_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:predicate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:parent_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:parent_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:child_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:PredicateEnum ;
            owl:onProperty hmd:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:child_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:child_id ] ;
    skos:definition "概念层级边。检索时的子树扩展依赖这张表 （查 NSCLC 要能召回 MET ex14 skipping 肺腺癌）。" ;
    skos:inScheme hmd:concept .

hmd:Mapping a owl:Class ;
    rdfs:label "Mapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty hmd:mapping_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:object_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:predicate_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:object_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:mapping_tool ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:mapping_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:subject_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:object_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:predicate_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:object_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:mapping_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:object_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:mapping_tool ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:MappingJustificationEnum ;
            owl:onProperty hmd:mapping_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:object_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:PredicateEnum ;
            owl:onProperty hmd:predicate_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:mapping_tool ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:subject_label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:mapping_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:subject_label ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^HMDM:\\d{9}$" ] ) ] ) ] ;
            owl:onProperty hmd:mapping_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:author_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:mapping_justification ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:author_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:author_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:mapping_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LicenseTierEnum ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ReviewStatusEnum ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:subject_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:subject_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:mapping_id ] ;
    skos:definition "SSSOM 映射记录。外采数据（UMLS / DrugBank / 智慧芽 / 医药魔方） 一律通过此表挂靠到内部 CURIE，而非替代内部 ID（设计决策 D9）。 这让底座保持供应商中立：停订阅只失去一组 xref，内部 ID 与历史报告不受影响。" ;
    skos:exactMatch sssom:Mapping ;
    skos:inScheme hmd:concept .

hmd:Synonym a owl:Class ;
    rdfs:label "Synonym" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty hmd:valid_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:valid_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:alias_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:valid_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:alias_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:is_ambiguous ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:alias_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty hmd:valid_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:is_ambiguous ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:alias_raw ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:valid_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hmd:is_ambiguous ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:alias_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:alias_raw ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LanguageEnum ;
            owl:onProperty hmd:lang ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:AliasTypeEnum ;
            owl:onProperty hmd:alias_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:scope ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:source ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:valid_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:minInclusive 0e+00 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1e+00 ] ) ] ) ] ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:alias_raw ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:SynonymScopeEnum ;
            owl:onProperty hmd:scope ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^HMDA:\\d{9}$" ] ) ] ) ] ;
            owl:onProperty hmd:alias_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:alias_norm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:alias_norm ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LicenseTierEnum ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:alias_norm ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ReviewStatusEnum ;
            owl:onProperty hmd:review_status ] ;
    skos:definition "别名条目。scope 必填 —— 检索扩展行为完全由 scope 驱动（D2）。 is_ambiguous 为真时，该别名不得直接单选，必须走上下文消歧（D3）。" ;
    skos:inScheme hmd:concept .

hmd:concept.owl.ttl a owl:Ontology ;
    rdfs:label "hmd_concept" ;
    dcterms:license "Proprietary" ;
    dcterms:title "HMD Concept and Alias Model" ;
    skos:definition "术语层核心模型（L1）。 概念的主键是内部 CURIE 而非外部 ID（设计决策 D1）—— 外部本体的 obsolete / merge 是常态，用外部 ID 当主键会让下游索引与历史报告一起崩。" .

hmd:justification a owl:ObjectProperty ;
    rdfs:label "justification" ;
    rdfs:range hmd:MappingJustificationEnum ;
    skos:definition "决策依据。术语映射、标引、归一化共用同一套词表（设计决策 D7）。" ;
    skos:inScheme hmd:types .

oio:hasBroadSynonym a owl:Class ;
    rdfs:label "BROAD" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "更宽的说法。默认不扩展、不入索引，避免召回泛化" ;
    hmd:expansion_weight 0e+00 ;
    hmd:indexed false .

oio:hasExactSynonym a owl:Class ;
    rdfs:label "EXACT" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "完全等价。全权重扩展 + 写入索引" ;
    hmd:expansion_weight 1e+00 ;
    hmd:indexed true .

oio:hasNarrowSynonym a owl:Class ;
    rdfs:label "NARROW" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "更窄的说法。降权 0.8 扩展 + 写入索引" ;
    hmd:expansion_weight 8e-01 ;
    hmd:indexed true .

oio:hasRelatedSynonym a owl:Class ;
    rdfs:label "RELATED" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "相关但不等价。永不扩展，仅作 rerank 特征" ;
    hmd:expansion_weight 0e+00 ;
    hmd:indexed false .

skos:broadMatch a owl:Class ;
    rdfs:label "broad_match" ;
    rdfs:subClassOf hmd:PredicateEnum .

skos:closeMatch a owl:Class ;
    rdfs:label "close_match" ;
    rdfs:subClassOf hmd:PredicateEnum .

skos:exactMatch a owl:Class ;
    rdfs:label "exact_match" ;
    rdfs:subClassOf hmd:PredicateEnum ;
