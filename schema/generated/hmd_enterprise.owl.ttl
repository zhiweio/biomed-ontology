@prefix OIO: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hmd: <https://w3id.org/asliva/biomed-ontology/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hmd:KnowledgeClaim a owl:Class ;
    rdfs:label "KnowledgeClaim" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:object_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:claim_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:object_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:claim_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:object_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:object_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:object_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:claim_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:source_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:extracted_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:created_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:object_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:source_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:source_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:extracted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:extracted_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:evidence_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:source_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:created_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:created_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ClaimStatusEnum ;
            owl:onProperty hmd:claim_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source_count ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:claim_status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:evidence_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:subject_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ClaimPredicateEnum ;
            owl:onProperty hmd:predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:claim_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ProvenanceSourceTypeEnum ;
            owl:onProperty hmd:source_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:subject_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:source_count ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:subject_id ] ;
    skos:definition "带出处的知识断言。Knowledge ≠ Truth； Claim + Provenance + Evidence 才可被 Agent 消费。 claim_status=extracted 仅为候选；validated 才可物化为 World Model knowledge 边。" ;
    skos:inScheme hmd:enterprise .

hmd:enterprise.owl.ttl a owl:Ontology ;
    rdfs:label "hmd_enterprise" ;
    dcterms:license "Proprietary" ;
    dcterms:title "HMD Enterprise Ontology (World Model)" ;
    skos:definition "企业内部创新药研发世界模型（Enterprise Ontology）。 企业实体主键是 HMD:ENT:* CURIE，不是 BIOS / ChEBI 等外部概念 ID。 外部概念通过 exact_match_xrefs 挂接（skos:exactMatch / SSSOM）。" .

hmd:justification a owl:ObjectProperty ;
    rdfs:label "justification" ;
    rdfs:range hmd:MappingJustificationEnum ;
    skos:definition "决策依据。术语映射、标引、归一化共用同一套词表（设计决策 D7）。" ;
    skos:inScheme hmd:types .

hmd:DrugCandidate a owl:Class ;
    rdfs:label "DrugCandidate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:indications ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:active_ingredient_xrefs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:targets ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:indications ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:active_ingredient_xrefs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:program_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:targets ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:program_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:program_id ],
        hmd:EnterpriseEntity ;
    skos:definition "企业候选药物 / 管线分子（可对应多个外部 Chemical 概念）。" ;
    skos:exactMatch biolink:Drug ;
    skos:inScheme hmd:enterprise .

hmd:Experiment a owl:Class ;
    rdfs:label "Experiment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:target_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:performed_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:asset_fqn ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:performed_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:asset_fqn ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:performed_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:asset_fqn ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:target_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:candidate_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:indication_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:candidate_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:candidate_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:indication_ids ],
        hmd:EnterpriseEntity ;
    skos:definition "ELN / 内部实验批次。" ;
    skos:inScheme hmd:enterprise .

hmd:Indication a owl:Class ;
    rdfs:label "Indication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_kind ],
        hmd:EnterpriseEntity ;
    skos:definition "企业适应症实体。" ;
    skos:exactMatch biolink:Disease ;
    skos:inScheme hmd:enterprise .

hmd:Program a owl:Class ;
    rdfs:label "Program" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:therapeutic_area ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:therapeutic_area ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:therapeutic_area ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_kind ],
        hmd:EnterpriseEntity ;
    skos:definition "研发项目 / 管线项目。" ;
    skos:inScheme hmd:enterprise .

hmd:Publication a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:pmid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:pmid ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:pmid ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:mentions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:doi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:doi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:mentions ],
        hmd:EnterpriseEntity ;
    skos:definition "文献或专利在企业世界模型中的登记（证据入口，非全文）。" ;
    skos:inScheme hmd:enterprise .

hmd:Target a owl:Class ;
    rdfs:label "Target" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_kind ],
        hmd:EnterpriseEntity ;
    skos:definition "企业视角的靶点实体（可 exactMatch 到基因/蛋白外部概念）。" ;
    skos:exactMatch biolink:GeneOrGeneProduct ;
    skos:inScheme hmd:enterprise .

OIO:hasBroadSynonym a owl:Class ;
    rdfs:label "BROAD" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "更宽的说法。默认不扩展、不入索引，避免召回泛化" ;
    hmd:expansion_weight 0e+00 ;
    hmd:indexed false .

OIO:hasExactSynonym a owl:Class ;
    rdfs:label "EXACT" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "完全等价。全权重扩展 + 写入索引" ;
    hmd:expansion_weight 1e+00 ;
    hmd:indexed true .

OIO:hasNarrowSynonym a owl:Class ;
    rdfs:label "NARROW" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "更窄的说法。降权 0.8 扩展 + 写入索引" ;
    hmd:expansion_weight 8e-01 ;
    hmd:indexed true .

OIO:hasRelatedSynonym a owl:Class ;
    rdfs:label "RELATED" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "相关但不等价。永不扩展，仅作 rerank 特征" ;
    hmd:expansion_weight 0e+00 ;
    hmd:indexed false .

skos:broadMatch a owl:Class ;
    rdfs:label "broad_match" ;
    rdfs:subClassOf hmd:PredicateEnum .

skos:closeMatch a owl:Class ;
    rdfs:label "close_match" ;
    rdfs:subClassOf hmd:PredicateEnum .

skos:exactMatch a owl:Class ;
    rdfs:label "exact_match" ;
    rdfs:subClassOf hmd:PredicateEnum ;
    skos:definition "概念等价，用于构建 clique" .

skos:narrowMatch a owl:Class ;
    rdfs:label "narrow_match" ;
    rdfs:subClassOf hmd:PredicateEnum .

biolink:BiologicalEntity a owl:Class ;
    rdfs:label "BIOMARKER" ;
    rdfs:subClassOf hmd:EntityTypeEnum ;
    skos:definition "生物标志物 / 基因变异" ;
    hmd:id_segment "BMK" .

biolink:ChemicalEntity a owl:Class ;
    rdfs:label "SUBSTANCE" ;
    rdfs:subClassOf hmd:EntityTypeEnum ;
    skos:definition "药物 / 物质" ;
    hmd:id_segment "SUB" .

biolink:ClinicalTrial a owl:Class ;
    rdfs:label "TRIAL" ;
    rdfs:subClassOf hmd:EntityTypeEnum ;
    skos:definition "临床试验" ;
    hmd:id_segment "TRL" .

biolink:MolecularActivity a owl:Class ;
    rdfs:label "MECHANISM" ;
    rdfs:subClassOf hmd:EntityTypeEnum ;
    skos:definition "作用机制 MoA" ;
    hmd:id_segment "MOA" .

biolink:affects a owl:Class ;
    rdfs:label "inhibits" ;
    rdfs:subClassOf hmd:PredicateEnum ;
    skos:definition "抑制。属性 qualifier 记录方向与强度" .

biolink:biomarker_for a owl:Class ;
    rdfs:label "biomarker_for" ;
    rdfs:subClassOf hmd:PredicateEnum .

biolink:has_adverse_event a owl:Class ;
    rdfs:label "has_adverse_event" ;
    rdfs:subClassOf hmd:PredicateEnum .

biolink:has_target a owl:Class ;
    rdfs:label "has_target" ;
    rdfs:subClassOf hmd:PredicateEnum .

biolink:studied_to_treat a owl:Class ;
    rdfs:label "in_clinical_trial_for" ;
    rdfs:subClassOf hmd:PredicateEnum .

biolink:subclass_of a owl:Class ;
    rdfs:label "subclass_of" ;
    rdfs:subClassOf hmd:PredicateEnum .

biolink:treats a owl:Class ;
    rdfs:label "treats" ;
    rdfs:subClassOf hmd:PredicateEnum .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#ABBREV> a owl:Class ;
    rdfs:label "ABBREV" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "缩写，歧义高发区" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#BRAND> a owl:Class ;
    rdfs:label "BRAND" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "商品名" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#CHEMICAL_NAME> a owl:Class ;
    rdfs:label "CHEMICAL_NAME" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "化学名" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#INN> a owl:Class ;
    rdfs:label "INN" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "国际非专利药品名称" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#INTERNAL_CODE> a owl:Class ;
    rdfs:label "INTERNAL_CODE" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "企业内部研发代号，如 HMPL-504" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#LEGACY> a owl:Class ;
    rdfs:label "LEGACY" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "历史废弃名称" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#MISSPELLING> a owl:Class ;
    rdfs:label "MISSPELLING" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "常见拼写错误，只入索引不对外展示" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#PARTNER_CODE> a owl:Class ;
    rdfs:label "PARTNER_CODE" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "合作方研发代号，如 AZD6094" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#RESEARCH_CODE> a owl:Class ;
    rdfs:label "RESEARCH_CODE" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "通用研究代号" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#SYMBOL> a owl:Class ;
    rdfs:label "SYMBOL" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "基因/蛋白符号" .

<https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#TRANSLATION> a owl:Class ;
    rdfs:label "TRANSLATION" ;
    rdfs:subClassOf hmd:AliasTypeEnum ;
    skos:definition "翻译名（中文层主力类型）" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#associatedWith> a owl:Class ;
    rdfs:label "associatedWith" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "靶点与适应症等关联" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#belongsTo> a owl:Class ;
    rdfs:label "belongsTo" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "属于某项目" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#hasActivityIn> a owl:Class ;
    rdfs:label "hasActivityIn" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "在模型或疾病场景中显示活性" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#hasAssay> a owl:Class ;
    rdfs:label "hasAssay" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "候选药关联某 LIMS / Assay" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#hasBiomarker> a owl:Class ;
    rdfs:label "hasBiomarker" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "关联生物标志物" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#hasMechanism> a owl:Class ;
    rdfs:label "hasMechanism" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "作用机制" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#hasResult> a owl:Class ;
    rdfs:label "hasResult" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "实验结果类断言" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#inPathway> a owl:Class ;
    rdfs:label "inPathway" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "参与通路" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#inhibits> a owl:Class ;
    rdfs:label "inhibits" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "抑制（如磷酸化/通路活性）" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#investigates> a owl:Class ;
    rdfs:label "investigates" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "研究某适应症" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#mentions> a owl:Class ;
    rdfs:label "mentions" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "文献提及实体" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#sameAsExternal> a owl:Class ;
    rdfs:label "sameAsExternal" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "映射到外部概念" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#supportedBy> a owl:Class ;
    rdfs:label "supportedBy" ;
    rdfs:subClassOf hmd:ClaimPredicateEnum ;
    skos:definition "断言被某证据条目支持（object 宜为 Evidence ID，勿倒置主体）" .

<https://w3id.org/asliva/biomed-ontology/ClaimPredicateEnum#targets> a owl:Class ;
    rdfs:label "targets" ;
