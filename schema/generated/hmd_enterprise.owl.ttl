hmd:ClaimStatusEnum a owl:Class ;
    rdfs:label "ClaimStatusEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/ClaimStatusEnum#extracted> <https://w3id.org/asliva/biomed-ontology/ClaimStatusEnum#validated> ) ;
    skos:inScheme hmd:enterprise ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/ClaimStatusEnum#extracted>,
        <https://w3id.org/asliva/biomed-ontology/ClaimStatusEnum#validated> .

hmd:LicenseTierEnum a owl:Class ;
    rdfs:label "LicenseTierEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_0> <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_1> <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_2> <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_3> ) ;
    skos:definition "许可分层（设计决策 D10），借鉴 UMLS SAB license category 机制。 tier 决定 RDF named graph 隔离策略、查询重写、导出闸门与训练语料准入。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_0>,
        <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_1>,
        <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_2>,
        <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_3> .

hmd:RetrievalChannelEnum a owl:Class ;
    rdfs:label "RetrievalChannelEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#BM25> <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#DENSE> <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#GRAPH> <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#FUSED> ) ;
    skos:definition "召回通道。融合前必须留存，否则无法归因是哪一路把结果带进来的。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#BM25>,
        <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#DENSE>,
        <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#FUSED>,
        <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#GRAPH> .

hmd:ReviewStatusEnum a owl:Class ;
    rdfs:label "ReviewStatusEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#PENDING> <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#APPROVED> <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#REJECTED> <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#AUTO_TRUSTED> ) ;
    skos:definition "审校状态。LLM 与规则生成的内容一律以 PENDING 入库， 未经人工审校不得进入 agent 返回体（设计决策 D5）。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#APPROVED>,
        <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#AUTO_TRUSTED>,
        <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#PENDING>,
        <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#REJECTED> .

hmd:SynonymScopeEnum a owl:Class ;
    rdfs:label "SynonymScopeEnum" ;
    owl:unionOf ( OIO:hasExactSynonym OIO:hasNarrowSynonym OIO:hasBroadSynonym OIO:hasRelatedSynonym ) ;
    skos:definition "别名范围，直接决定检索行为（设计决策 D2）。 把 related 当作等价会摧毁精确率，因此 scope 是必填字段而非可选标注。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values OIO:hasBroadSynonym,
        OIO:hasExactSynonym,
        OIO:hasNarrowSynonym,
        OIO:hasRelatedSynonym .

hmd:EntityStatusEnum a owl:Class ;
    rdfs:label "EntityStatusEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/EntityStatusEnum#active> <https://w3id.org/asliva/biomed-ontology/EntityStatusEnum#deprecated> <https://w3id.org/asliva/biomed-ontology/EntityStatusEnum#draft> ) ;
    skos:inScheme hmd:enterprise ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/EntityStatusEnum#active>,
        <https://w3id.org/asliva/biomed-ontology/EntityStatusEnum#deprecated>,
        <https://w3id.org/asliva/biomed-ontology/EntityStatusEnum#draft> .

hmd:ModalityChannelEnum a owl:Class ;
    rdfs:label "ModalityChannelEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#TEXT> <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#TABLE> <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#IMAGE> <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#STRUCTURE> <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#METADATA> ) ;
    skos:definition "抽取通道。三模态各自的错误模式不同，混在一起就无法分模态评估准确率， 也无法定位是解析失败还是抽取失败。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#IMAGE>,
        <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#METADATA>,
        <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#STRUCTURE>,
        <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#TABLE>,
        <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#TEXT> .

hmd:NormalizationStageEnum a owl:Class ;
    rdfs:label "NormalizationStageEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#DICTIONARY> <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#RULE> <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#VECTOR> <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#LLM> <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#ABSTAIN> ) ;
    skos:definition "归一化级联的阶段枚举（设计决策 D7 的执行点）。 每一级的代价与可信度都不同，记录命中在哪一级才能优化级联本身。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#ABSTAIN>,
        <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#DICTIONARY>,
        <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#LLM>,
        <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#RULE>,
        <https://w3id.org/asliva/biomed-ontology/NormalizationStageEnum#VECTOR> .

hmd:EnterpriseEntity a owl:Class ;
    rdfs:label "EnterpriseEntity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:related_xrefs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:aliases ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:EnterpriseKindEnum ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:aliases ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:exact_match_xrefs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:related_xrefs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:enterprise_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:entity_kind ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:exact_match_xrefs ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:enterprise_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:enterprise_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:EntityStatusEnum ;
            owl:onProperty hmd:status ],
        [ owl:unionOf ( hmd:DrugCandidate hmd:Experiment hmd:Indication hmd:Program hmd:Publication hmd:Target ) ] ;
    skos:definition "企业世界模型实体基类。主键永不复用；废弃走 replaced_by。" ;
    skos:inScheme hmd:enterprise .

hmd:HeadingSourceEnum a owl:Class ;
    rdfs:label "HeadingSourceEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#TOC_EXACT> <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#TOC_FUZZY> <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#HEADING_REGEX> <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#VLM_SCAN> <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#LLM_REFINE> <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#SYNTHETIC> ) ;
    skos:definition "章节标题的判定来源。语义树的层级不是从文档里\"读\"出来的，是多源候选竞争后 \"判\"出来的 —— 记录判据才能回答\"这一级标题凭什么定成 H2\"， 也才能在解析质量出问题时定位到是哪一路候选失准。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#HEADING_REGEX>,
        <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#LLM_REFINE>,
        <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#SYNTHETIC>,
        <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#TOC_EXACT>,
        <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#TOC_FUZZY>,
        <https://w3id.org/asliva/biomed-ontology/HeadingSourceEnum#VLM_SCAN> .

hmd:SignalStatusEnum a owl:Class ;
    rdfs:label "SignalStatusEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#NEW> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#TRIAGED> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#CANDIDATE_GENERATED> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#CURATED> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#RELEASED> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#DISMISSED> ) ;
    skos:definition "信号的处理状态，审校队列按此流转。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#CANDIDATE_GENERATED>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#CURATED>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#DISMISSED>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#NEW>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#RELEASED>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#TRIAGED> .

hmd:EntityTypeEnum a owl:Class ;
    rdfs:label "EntityTypeEnum" ;
    owl:unionOf ( biolink:GeneOrGeneProduct biolink:ChemicalEntity biolink:Disease biolink:MolecularActivity <https://w3id.org/asliva/biomed-ontology/EntityTypeEnum#MODALITY> biolink:ClinicalTrial biolink:BiologicalEntity <https://w3id.org/asliva/biomed-ontology/EntityTypeEnum#ADVERSE_EVENT> ) ;
    skos:definition "本次 scope 内的实体类型。每个类型对应一个 HMD ID 命名空间段。 AE（不良事件）依赖 MedDRA 采购，PoC 阶段为空占位。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values biolink:BiologicalEntity,
        biolink:ChemicalEntity,
        biolink:ClinicalTrial,
        biolink:Disease,
        biolink:GeneOrGeneProduct,
        biolink:MolecularActivity,
        <https://w3id.org/asliva/biomed-ontology/EntityTypeEnum#ADVERSE_EVENT>,
        <https://w3id.org/asliva/biomed-ontology/EntityTypeEnum#MODALITY> .

hmd:SignalTypeEnum a owl:Class ;
    rdfs:label "SignalTypeEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#unmapped_span> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#low_confidence_normalization> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#ambiguous_unstable> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#zero_result_query> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#expansion_miss> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#negative_feedback> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#cooccurrence_anomaly> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#multi_source_conflict> ) ;
    skos:definition "演进闭环的信号类型（L8）。 信号来自真实使用，比人工巡检更能反映本体的实际缺口。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#ambiguous_unstable>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#cooccurrence_anomaly>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#expansion_miss>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#low_confidence_normalization>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#multi_source_conflict>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#negative_feedback>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#unmapped_span>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#zero_result_query> .

hmd:MappingJustificationEnum a owl:Class ;
    rdfs:label "MappingJustificationEnum" ;
    owl:unionOf ( <https://w3id.org/semapv/vocab/LexicalMatching> <https://w3id.org/semapv/vocab/CompositeMatching> <https://w3id.org/semapv/vocab/ManualMappingCuration> <https://w3id.org/semapv/vocab/MappingChaining> <https://w3id.org/semapv/vocab/UnspecifiedMatching> <https://w3id.org/semapv/vocab/SemanticSimilarityThresholdMatching> <https://w3id.org/asliva/biomed-ontology/MappingJustificationEnum#OntologyDescendantExpansion> <https://w3id.org/asliva/biomed-ontology/MappingJustificationEnum#LLMDisambiguation> ) ;
    skos:definition "映射与决策的依据词表（设计决策 D7）。 semapv 为标准词表，hmd: 前缀为本项目扩展。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/MappingJustificationEnum#LLMDisambiguation>,
        <https://w3id.org/asliva/biomed-ontology/MappingJustificationEnum#OntologyDescendantExpansion>,
        <https://w3id.org/semapv/vocab/CompositeMatching>,
        <https://w3id.org/semapv/vocab/LexicalMatching>,
        <https://w3id.org/semapv/vocab/ManualMappingCuration>,
        <https://w3id.org/semapv/vocab/MappingChaining>,
        <https://w3id.org/semapv/vocab/SemanticSimilarityThresholdMatching>,
        <https://w3id.org/semapv/vocab/UnspecifiedMatching> .

