hmd:PredicateEnum a owl:Class ;
    rdfs:label "PredicateEnum" ;
    owl:unionOf ( skos:exactMatch skos:closeMatch skos:broadMatch skos:narrowMatch biolink:subclass_of biolink:affects biolink:treats biolink:has_target biolink:biomarker_for biolink:has_adverse_event biolink:studied_to_treat ) ;
    skos:definition "关系谓词，取 Biolink Model 子集。 不自造谓词 —— 与 Biolink 对齐才能让外采数据与开源图谱无损融合。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values skos:broadMatch,
        skos:closeMatch,
        skos:exactMatch,
        skos:narrowMatch,
        biolink:affects,
        biolink:biomarker_for,
        biolink:has_adverse_event,
        biolink:has_target,
        biolink:studied_to_treat,
        biolink:subclass_of,
        biolink:treats .

