hmd:Candidate a owl:Class ;
    rdfs:label "Candidate" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:label ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:candidate_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:channel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:channel ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:channel ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:candidate_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:candidate_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:label ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:stage ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:label ] ;
    skos:definition "决策过程中的一个候选项。保留 score 与 channel 才能做通道级归因。" ;
    skos:inScheme hmd:obs .

hmd:ConceptAlternative a owl:Class ;
    rdfs:label "ConceptAlternative" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_en ] ;
    skos:definition "消歧未确定时返回的备选。宁可返回 top-k + 置信度，也不猜一个（设计决策 D3）。" ;
    skos:inScheme hmd:agentapi .

hmd:ConceptDetail a owl:Class ;
    rdfs:label "ConceptDetail" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ReviewStatusEnum ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:EntityTypeEnum ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:children ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:children ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LicenseTierEnum ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:parents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:parents ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_zh ] ;
    skos:definition "get_concept 的详情块。包含 children 而非只有 parents： agent 做层级扩展时需要向下看，只给父链会逼它再发一轮查询。" ;
    skos:inScheme hmd:agentapi .

