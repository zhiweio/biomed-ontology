hmd:Evidence a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:bbox ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:char_start ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:char_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:section ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:title ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:quote ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ModalityChannelEnum ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:quote ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:page ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:quote ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:char_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:page ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:char_start ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:chunk_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:char_start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:section ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:bbox ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:section ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:chunk_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^DOC:[A-Za-z0-9._:-]+$" ] ) ] ) ] ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:char_end ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:page ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^CHK:[A-Za-z0-9._:-]+$" ] ) ] ) ] ;
            owl:onProperty hmd:chunk_id ] ;
    skos:definition "事实的出处。一条事实可有多条证据，多证据支持会提升 confidence。" ;
    skos:inScheme hmd:fact .

hmd:ExpansionTermOut a owl:Class ;
    rdfs:label "ExpansionTermOut" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LanguageEnum ;
            owl:onProperty hmd:lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:term ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:depth ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^HMDA:\\d{9}$" ] ) ] ) ] ;
