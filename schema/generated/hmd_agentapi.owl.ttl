    rdfs:range xsd:float ;
    skos:inScheme hmd:obs .

hmd:signal_id a owl:DatatypeProperty ;
    rdfs:label "signal_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^HMDS:\\d{9}$" ] ) ] ) ] ;
    skos:inScheme hmd:obs .

hmd:span_id a owl:DatatypeProperty ;
    rdfs:label "span_id" ;
    rdfs:range xsd:string ;
    skos:inScheme hmd:obs .

hmd:subject_label a owl:DatatypeProperty ;
    rdfs:label "subject_label" ;
    rdfs:range xsd:string ;
    skos:inScheme hmd:concept .

hmd:target_id a owl:DatatypeProperty ;
    rdfs:label "target_id" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme hmd:agentapi .

hmd:text a owl:DatatypeProperty ;
    rdfs:label "text" ;
    rdfs:range xsd:string ;
    skos:inScheme hmd:fact .

hmd:tool_name a owl:DatatypeProperty ;
    rdfs:label "tool_name" ;
    rdfs:range xsd:string ;
    skos:inScheme hmd:obs .

hmd:tool_version a owl:DatatypeProperty ;
    rdfs:label "tool_version" ;
    rdfs:range xsd:string ;
    skos:inScheme hmd:obs .

hmd:ts a owl:DatatypeProperty ;
    rdfs:label "ts" ;
    rdfs:range xsd:dateTime ;
    skos:inScheme hmd:obs .

hmd:ToolEnvelope a owl:Class ;
    rdfs:label "ToolEnvelope" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:elapsed_ms ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:trace_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:ontology_release_id ],
        [ owl:unionOf ( hmd:ExpandResponse hmd:FactsResponse hmd:FeedbackResponse hmd:LandscapeResponse hmd:NormalizeResponse hmd:SearchResponse hmd:SparqlResponse ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:tool_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:license_filtered_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:tool_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:license_filtered_count ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:elapsed_ms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:license_filtered_count ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:tool_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:ontology_release_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:warnings ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:license_tier_max ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:elapsed_ms ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:trace_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:tool_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:ontology_release_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:tool_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LicenseTierEnum ;
            owl:onProperty hmd:license_tier_max ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:trace_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:warnings ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:tool_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:license_tier_max ] ;
    skos:definition "所有 tool 返回体的公共头。做成抽象基类而非各自定义， 是为了让可观测埋点与许可闸门可以统一处理任意 tool 的输出。" ;
    skos:inScheme hmd:agentapi .

hmd:primary_xref a owl:DatatypeProperty ;
    rdfs:label "primary_xref" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme hmd:concept .

hmd:SignalStatusEnum a owl:Class ;
    rdfs:label "SignalStatusEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#NEW> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#TRIAGED> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#CANDIDATE_GENERATED> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#CURATED> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#RELEASED> <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#DISMISSED> ) ;
    skos:definition "信号的处理状态，审校队列按此流转。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#CANDIDATE_GENERATED>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#CURATED>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#DISMISSED>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#NEW>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#RELEASED>,
        <https://w3id.org/asliva/biomed-ontology/SignalStatusEnum#TRIAGED> .

hmd:SynonymScopeEnum a owl:Class ;
    rdfs:label "SynonymScopeEnum" ;
    owl:unionOf ( OIO:hasExactSynonym OIO:hasNarrowSynonym OIO:hasBroadSynonym OIO:hasRelatedSynonym ) ;
    skos:definition "别名范围，直接决定检索行为（设计决策 D2）。 把 related 当作等价会摧毁精确率，因此 scope 是必填字段而非可选标注。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values OIO:hasBroadSynonym,
        OIO:hasExactSynonym,
        OIO:hasNarrowSynonym,
        OIO:hasRelatedSynonym .

hmd:TaxonomyDimensionEnum a owl:Class ;
    rdfs:label "TaxonomyDimensionEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#DOC_TYPE> <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#RD_STAGE> <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#EVIDENCE_TYPE> <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#TECH_TOPIC> <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#PATENT_DIM> ) ;
    skos:definition "标引维度。设成正交多维而非单一分类树，是因为\"综述 / III 期 / 耐药机制 / 小分子\" 这四件事互不蕴含，压进一棵树会逼出笛卡尔积式的标签爆炸。" ;
    skos:inScheme hmd:taxonomy ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#DOC_TYPE>,
        <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#EVIDENCE_TYPE>,
        <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#PATENT_DIM>,
        <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#RD_STAGE>,
        <https://w3id.org/asliva/biomed-ontology/TaxonomyDimensionEnum#TECH_TOPIC> .

hmd:FeedbackVerdictEnum a owl:Class ;
    rdfs:label "FeedbackVerdictEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#CORRECT> <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#WRONG_CONCEPT> <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#MISSING_ALIAS> <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#MISSING_DOCUMENT> <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#IRRELEVANT_RESULT> <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#WRONG_FACT> <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#MISSING_PROVENANCE> ) ;
    skos:definition "反馈判定。区分错误类型才能路由到不同的信号类型与审校队列。" ;
    skos:inScheme hmd:agentapi ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#CORRECT>,
        <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#IRRELEVANT_RESULT>,
        <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#MISSING_ALIAS>,
        <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#MISSING_DOCUMENT>,
        <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#MISSING_PROVENANCE>,
        <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#WRONG_CONCEPT>,
        <https://w3id.org/asliva/biomed-ontology/FeedbackVerdictEnum#WRONG_FACT> .

hmd:RetrievalChannelEnum a owl:Class ;
    rdfs:label "RetrievalChannelEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#BM25> <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#DENSE> <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#GRAPH> <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#FUSED> ) ;
    skos:definition "召回通道。融合前必须留存，否则无法归因是哪一路把结果带进来的。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#BM25>,
        <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#DENSE>,
        <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#FUSED>,
        <https://w3id.org/asliva/biomed-ontology/RetrievalChannelEnum#GRAPH> .

hmd:alias_id a owl:DatatypeProperty ;
    rdfs:label "alias_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^HMDA:\\d{9}$" ] ) ] ) ] ;
    skos:definition "别名条目的稳定 ID。可观测埋点回传的就是这个 ID —— 归因排障时要能从一条错误结论定位到具体哪一行别名（Demo 场景 4）。" ;
    skos:inScheme hmd:concept .

hmd:definition a owl:DatatypeProperty ;
    rdfs:label "definition" ;
    skos:inScheme hmd:concept .

hmd:entity_type a owl:ObjectProperty ;
    rdfs:label "entity_type" ;
    rdfs:range hmd:EntityTypeEnum ;
    skos:inScheme hmd:concept .

hmd:justification a owl:ObjectProperty ;
    rdfs:label "justification" ;
    rdfs:range hmd:MappingJustificationEnum ;
    skos:definition "决策依据。术语映射、标引、归一化共用同一套词表（设计决策 D7）。" ;
    skos:inScheme hmd:types .

hmd:object_id a owl:DatatypeProperty ;
    rdfs:label "object_id" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme hmd:concept .

hmd:ontology_release_id a owl:DatatypeProperty ;
    rdfs:label "ontology_release_id" ;
    rdfs:range xsd:string ;
    skos:inScheme hmd:obs .

hmd:predicate a owl:ObjectProperty ;
    rdfs:label "predicate" ;
    rdfs:range hmd:PredicateEnum ;
    skos:inScheme hmd:concept .

hmd:preferred_label_zh a owl:DatatypeProperty ;
    rdfs:label "preferred_label_zh" ;
    skos:definition "中文首选标签。中文层是自建增量（D5）—— 开放许可源的中文覆盖不足，LLM 生成的候选必须人工审校后才能升为 preferred。" ;
    skos:inScheme hmd:concept .

hmd:scope a owl:ObjectProperty ;
    rdfs:label "scope" ;
    rdfs:range hmd:SynonymScopeEnum ;
    skos:inScheme hmd:concept .

hmd:source a owl:DatatypeProperty ;
    rdfs:label "source" ;
    skos:definition "数据源标识，必须在 source registry 中注册" ;
    skos:inScheme hmd:concept .

hmd:source_version a owl:DatatypeProperty ;
    rdfs:label "source_version" ;
    skos:definition "源快照版本。缺此字段无法做离线可重放构建" ;
    skos:inScheme hmd:concept .

hmd:subject_id a owl:DatatypeProperty ;
    rdfs:label "subject_id" ;
    rdfs:range xsd:anyURI ;
    skos:inScheme hmd:concept .

hmd:title a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string ;
    skos:inScheme hmd:fact .

hmd:LanguageEnum a owl:Class ;
    rdfs:label "LanguageEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/LanguageEnum#en> <https://w3id.org/asliva/biomed-ontology/LanguageEnum#zh> <https://w3id.org/asliva/biomed-ontology/LanguageEnum#la> ) ;
    skos:definition "别名语言。中英必须互通，拉丁名用于化学与物种" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/LanguageEnum#en>,
        <https://w3id.org/asliva/biomed-ontology/LanguageEnum#la>,
        <https://w3id.org/asliva/biomed-ontology/LanguageEnum#zh> .

hmd:ModalityChannelEnum a owl:Class ;
    rdfs:label "ModalityChannelEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#TEXT> <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#TABLE> <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#IMAGE> <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#STRUCTURE> <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#METADATA> ) ;
    skos:definition "抽取通道。三模态各自的错误模式不同，混在一起就无法分模态评估准确率， 也无法定位是解析失败还是抽取失败。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#IMAGE>,
        <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#METADATA>,
        <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#STRUCTURE>,
        <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#TABLE>,
        <https://w3id.org/asliva/biomed-ontology/ModalityChannelEnum#TEXT> .

hmd:ReviewStatusEnum a owl:Class ;
    rdfs:label "ReviewStatusEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#PENDING> <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#APPROVED> <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#REJECTED> <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#AUTO_TRUSTED> ) ;
    skos:definition "审校状态。LLM 与规则生成的内容一律以 PENDING 入库， 未经人工审校不得进入 agent 返回体（设计决策 D5）。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#APPROVED>,
        <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#AUTO_TRUSTED>,
        <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#PENDING>,
        <https://w3id.org/asliva/biomed-ontology/ReviewStatusEnum#REJECTED> .

hmd:SignalTypeEnum a owl:Class ;
    rdfs:label "SignalTypeEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#unmapped_span> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#low_confidence_normalization> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#ambiguous_unstable> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#zero_result_query> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#expansion_miss> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#negative_feedback> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#cooccurrence_anomaly> <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#multi_source_conflict> ) ;
    skos:definition "演进闭环的信号类型（L8）。 信号来自真实使用，比人工巡检更能反映本体的实际缺口。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#ambiguous_unstable>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#cooccurrence_anomaly>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#expansion_miss>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#low_confidence_normalization>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#multi_source_conflict>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#negative_feedback>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#unmapped_span>,
        <https://w3id.org/asliva/biomed-ontology/SignalTypeEnum#zero_result_query> .

hmd:DocTypeEnum a owl:Class ;
    rdfs:label "DocTypeEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#JOURNAL_ARTICLE> <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#PREPRINT> <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#CONFERENCE_ABSTRACT> <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#CLINICAL_TRIAL_RECORD> <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#PATENT> <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#REGULATORY_DOCUMENT> <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#LABEL> <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#INTERNAL_REPORT> ) ;
    skos:definition "文档类型，标引分类的第一个维度，也决定用哪套解析与抽取规则。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#CLINICAL_TRIAL_RECORD>,
        <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#CONFERENCE_ABSTRACT>,
        <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#INTERNAL_REPORT>,
        <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#JOURNAL_ARTICLE>,
        <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#LABEL>,
        <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#PATENT>,
        <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#PREPRINT>,
        <https://w3id.org/asliva/biomed-ontology/DocTypeEnum#REGULATORY_DOCUMENT> .

