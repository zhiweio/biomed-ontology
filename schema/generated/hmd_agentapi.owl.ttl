            owl:onProperty hmd:accepted ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^HMDS:\\d{9}$" ] ) ] ) ] ;
            owl:onProperty hmd:signal_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:signal_id ],
        hmd:ToolEnvelope ;
    skos:inScheme hmd:agentapi .

hmd:LandscapeResponse a owl:Class ;
    rdfs:label "LandscapeResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:landscape_rows ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:total ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:total ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LandscapeRow ;
            owl:onProperty hmd:landscape_rows ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:total ],
        hmd:ToolEnvelope ;
    skos:inScheme hmd:agentapi .

hmd:NormalizeResponse a owl:Class ;
    rdfs:label "NormalizeResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
