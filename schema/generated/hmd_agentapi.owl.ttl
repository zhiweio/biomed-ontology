        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:title ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:rank_before_rerank ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:explain ],
