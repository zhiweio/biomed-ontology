            owl:onProperty hmd:tool_name ] ;
    skos:definition "I/O 支柱（WHAT）：每次 tool 调用的完整输入输出。 全量留存的价值在于可重放与可审计；契约校验结果同表存放，违约即可告警。" ;
    skos:inScheme hmd:obs .

hmd:agentapi.owl.ttl a owl:Ontology ;
    rdfs:label "hmd_agentapi" ;
    dcterms:license "Proprietary" ;
    dcterms:title "HMD Agent Tool I/O Contract" ;
    skos:definition """Agent 工具契约（L6）。这份 schema 是底座与 agent 团队之间的接口约定， 由它生成 JSON Schema 用于运行时双向校验，也由它生成 MCP tool 描述。
三条不可协商的约定： 1. 每个返回体都带 trace_id 与 ontology_release_id —— 否则无法归因、无法重放、反馈无处挂靠 2. 每条结果都带 provenance —— 无出处的结论在药物研发场景不可用 3. 每条结果都带 license_tier —— 调用方需要知道哪些内容不可外发""" .

hmd:ExpandResponse a owl:Class ;
    rdfs:label "ExpandResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ExpansionTermOut ;
            owl:onProperty hmd:expansion_terms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:expansion_terms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:expansion_size ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:concept_detail ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:expansion_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ConceptDetail ;
            owl:onProperty hmd:concept_detail ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:expansion_size ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_detail ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:concept_id ],
        hmd:ToolEnvelope ;
    skos:inScheme hmd:agentapi .

hmd:FactsResponse a owl:Class ;
    rdfs:label "FactsResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hmd:Fact ;
            owl:onProperty hmd:facts ],
        [ a owl:Restriction ;
