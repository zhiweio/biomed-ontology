    skos:inScheme hmd:obs .

hmd:AliasTypeEnum a owl:Class ;
    rdfs:label "AliasTypeEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#INN> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#BRAND> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#INTERNAL_CODE> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#PARTNER_CODE> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#RESEARCH_CODE> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#ABBREV> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#SYMBOL> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#CHEMICAL_NAME> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#TRANSLATION> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#MISSPELLING> <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#LEGACY> ) ;
    skos:definition "别名的来源性质，用于消歧打分与审校优先级排序" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#ABBREV>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#BRAND>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#CHEMICAL_NAME>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#INN>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#INTERNAL_CODE>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#LEGACY>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#MISSPELLING>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#PARTNER_CODE>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#RESEARCH_CODE>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#SYMBOL>,
        <https://w3id.org/asliva/biomed-ontology/AliasTypeEnum#TRANSLATION> .

hmd:EntityTypeEnum a owl:Class ;
    rdfs:label "EntityTypeEnum" ;
    owl:unionOf ( <https://w3id.org/biolink/vocab/GeneOrGeneProduct> <https://w3id.org/biolink/vocab/ChemicalEntity> <https://w3id.org/biolink/vocab/Disease> <https://w3id.org/biolink/vocab/MolecularActivity> <https://w3id.org/asliva/biomed-ontology/EntityTypeEnum#MODALITY> <https://w3id.org/biolink/vocab/ClinicalTrial> <https://w3id.org/biolink/vocab/BiologicalEntity> <https://w3id.org/asliva/biomed-ontology/EntityTypeEnum#ADVERSE_EVENT> ) ;
    skos:definition "本次 scope 内的实体类型。每个类型对应一个 HMD ID 命名空间段。 AE（不良事件）依赖 MedDRA 采购，PoC 阶段为空占位。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/biolink/vocab/BiologicalEntity>,
        <https://w3id.org/biolink/vocab/ChemicalEntity>,
        <https://w3id.org/biolink/vocab/ClinicalTrial>,
        <https://w3id.org/biolink/vocab/Disease>,
        <https://w3id.org/biolink/vocab/GeneOrGeneProduct>,
        <https://w3id.org/biolink/vocab/MolecularActivity>,
        <https://w3id.org/asliva/biomed-ontology/EntityTypeEnum#ADVERSE_EVENT>,
        <https://w3id.org/asliva/biomed-ontology/EntityTypeEnum#MODALITY> .

hmd:review_status a owl:ObjectProperty ;
    rdfs:label "review_status" ;
    rdfs:range hmd:ReviewStatusEnum ;
    skos:inScheme hmd:concept .

hmd:MappingJustificationEnum a owl:Class ;
    rdfs:label "MappingJustificationEnum" ;
    owl:unionOf ( <https://w3id.org/semapv/vocab/LexicalMatching> <https://w3id.org/semapv/vocab/CompositeMatching> <https://w3id.org/semapv/vocab/ManualMappingCuration> <https://w3id.org/semapv/vocab/MappingChaining> <https://w3id.org/semapv/vocab/UnspecifiedMatching> <https://w3id.org/semapv/vocab/SemanticSimilarityThresholdMatching> <https://w3id.org/asliva/biomed-ontology/MappingJustificationEnum#OntologyDescendantExpansion> <https://w3id.org/asliva/biomed-ontology/MappingJustificationEnum#LLMDisambiguation> ) ;
    skos:definition "映射与决策的依据词表（设计决策 D7）。 semapv 为标准词表，hmd: 前缀为本项目扩展。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/MappingJustificationEnum#LLMDisambiguation>,
        <https://w3id.org/asliva/biomed-ontology/MappingJustificationEnum#OntologyDescendantExpansion>,
        <https://w3id.org/semapv/vocab/CompositeMatching>,
        <https://w3id.org/semapv/vocab/LexicalMatching>,
        <https://w3id.org/semapv/vocab/ManualMappingCuration>,
        <https://w3id.org/semapv/vocab/MappingChaining>,
        <https://w3id.org/semapv/vocab/SemanticSimilarityThresholdMatching>,
        <https://w3id.org/semapv/vocab/UnspecifiedMatching> .

hmd:PredicateEnum a owl:Class ;
    rdfs:label "PredicateEnum" ;
    owl:unionOf ( skos:exactMatch skos:closeMatch skos:broadMatch skos:narrowMatch <https://w3id.org/biolink/vocab/subclass_of> <https://w3id.org/biolink/vocab/affects> <https://w3id.org/biolink/vocab/treats> <https://w3id.org/biolink/vocab/has_target> <https://w3id.org/biolink/vocab/biomarker_for> <https://w3id.org/biolink/vocab/has_adverse_event> <https://w3id.org/biolink/vocab/studied_to_treat> ) ;
    skos:definition "关系谓词，取 Biolink Model 子集。 不自造谓词 —— 与 Biolink 对齐才能让外采数据与开源图谱无损融合。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values skos:broadMatch,
        skos:closeMatch,
        skos:exactMatch,
        skos:narrowMatch,
        <https://w3id.org/biolink/vocab/affects>,
        <https://w3id.org/biolink/vocab/biomarker_for>,
        <https://w3id.org/biolink/vocab/has_adverse_event>,
        <https://w3id.org/biolink/vocab/has_target>,
        <https://w3id.org/biolink/vocab/studied_to_treat>,
        <https://w3id.org/biolink/vocab/subclass_of>,
        <https://w3id.org/biolink/vocab/treats> .

hmd:doc_id a owl:DatatypeProperty ;
    rdfs:label "doc_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^DOC:[A-Za-z0-9._:-]+$" ] ) ] ) ] ;
    skos:inScheme hmd:fact .

hmd:LicenseTierEnum a owl:Class ;
    rdfs:label "LicenseTierEnum" ;
    owl:unionOf ( <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_0> <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_1> <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_2> <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_3> ) ;
    skos:definition "许可分层（设计决策 D10），借鉴 UMLS SAB license category 机制。 tier 决定 RDF named graph 隔离策略、查询重写、导出闸门与训练语料准入。" ;
    skos:inScheme hmd:types ;
    linkml:permissible_values <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_0>,
        <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_1>,
        <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_2>,
        <https://w3id.org/asliva/biomed-ontology/LicenseTierEnum#TIER_3> .

hmd:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence" ;
    rdfs:range xsd:float ;
    skos:inScheme hmd:concept .

hmd:concept_id a owl:DatatypeProperty ;
    rdfs:label "concept_id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "内部概念 CURIE" ;
    skos:inScheme hmd:concept .

hmd:license_tier a owl:ObjectProperty ;
    rdfs:label "license_tier" ;
    rdfs:range hmd:LicenseTierEnum ;
    skos:inScheme hmd:concept .

xsd:anyURI a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Za-z][A-Za-z0-9._-]*:\\S+$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^HMD:(TGT|SUB|DIS|MOA|MOD|TRL|BMK|AE):\\d{7}$" ] ) ] .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" ] ) ] .


