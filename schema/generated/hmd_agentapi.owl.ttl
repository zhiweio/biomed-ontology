hmd:FeedbackResponse a owl:Class ;
    rdfs:label "FeedbackResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hmd:accepted ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
