            owl:onProperty hmd:results ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:expansion_size ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:MatchedConcept ;
            owl:onProperty hmd:matched_concepts ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:SearchHit ;
            owl:onProperty hmd:results ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:total ],
        hmd:ToolEnvelope ;
    skos:inScheme hmd:agentapi .

hmd:SparqlResponse a owl:Class ;
    rdfs:label "SparqlResponse" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:total ],
        [ a owl:Restriction ;
