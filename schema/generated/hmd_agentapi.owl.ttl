        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:first_seen ] ;
    skos:definition "演进闭环的信号（L8）。 priority_score = 影响 query 数 × 影响文档数，审校队列按它排序 —— 本体缺口的价值不均等，按影响面排序才能让有限的审校人力用在刀刃上。" ;
    skos:inScheme hmd:obs .

hmd:SparqlRequest a owl:Class ;
