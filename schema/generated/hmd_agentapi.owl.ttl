OIO:hasBroadSynonym a owl:Class ;
    rdfs:label "BROAD" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "更宽的说法。默认不扩展、不入索引，避免召回泛化" ;
    hmd:expansion_weight 0e+00 ;
    hmd:indexed false .

OIO:hasExactSynonym a owl:Class ;
    rdfs:label "EXACT" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "完全等价。全权重扩展 + 写入索引" ;
    hmd:expansion_weight 1e+00 ;
    hmd:indexed true .

OIO:hasNarrowSynonym a owl:Class ;
    rdfs:label "NARROW" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "更窄的说法。降权 0.8 扩展 + 写入索引" ;
    hmd:expansion_weight 8e-01 ;
    hmd:indexed true .

OIO:hasRelatedSynonym a owl:Class ;
    rdfs:label "RELATED" ;
    rdfs:subClassOf hmd:SynonymScopeEnum ;
    skos:definition "相关但不等价。永不扩展，仅作 rerank 特征" ;
    hmd:expansion_weight 0e+00 ;
    hmd:indexed false .

