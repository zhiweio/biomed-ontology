        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:llm_invoked ],
        hmd:ToolEnvelope ;
    skos:inScheme hmd:agentapi .

hmd:SearchResponse a owl:Class ;
