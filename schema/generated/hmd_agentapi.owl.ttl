@prefix OIO: <http://www.geneontology.org/formats/oboInOwl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hmd: <https://w3id.org/asliva/biomed-ontology/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hmd:Chunk a owl:Class ;
    rdfs:label "Chunk" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:section ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:page ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:section ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:char_start ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:section ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_ids ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:char_end ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:bbox ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:concept_ids ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:bbox ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:char_start ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:page ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:chunk_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^CHK:[A-Za-z0-9._:-]+$" ] ) ] ) ] ;
            owl:onProperty hmd:chunk_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:concept_ids_expanded ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:page ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:char_end ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ModalityChannelEnum ;
            owl:onProperty hmd:modality ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:char_start ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^DOC:[A-Za-z0-9._:-]+$" ] ) ] ) ] ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:char_end ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:text ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_ids_expanded ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:text ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:chunk_id ] ;
    skos:definition "文档切片，检索与抽取的基本单位。 保留 section 与 bbox 是硬要求：provenance 要能把研究员的视线引到原文那一段。" ;
    skos:inScheme hmd:fact .

hmd:Clique a owl:Class ;
    rdfs:label "Clique" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:conflict_flags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:members ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:built_by_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:built_by_justification ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:MappingJustificationEnum ;
            owl:onProperty hmd:built_by_justification ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:members ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:conflict_flags ] ;
    skos:definition "等价团：一组通过 exact_match 互相连通的外部 ID 集合，对应唯一一个内部概念。 建团用连通分量算法，冲突（同团内出现两个来自同一权威源的不同 ID）进人工队列。" ;
    skos:inScheme hmd:concept .

hmd:Concept a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hmd:is_obsolete ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:consider ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:parents ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:equivalent_xrefs ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:preferred_label_zh ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:parents ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:replaced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:category ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:consider ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:preferred_label_en ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:EntityTypeEnum ;
            owl:onProperty hmd:entity_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:definition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:created_in_release ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:modified_in_release ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:is_obsolete ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:equivalent_xrefs ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:modified_in_release ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LicenseTierEnum ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:modified_in_release ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:category ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:primary_xref ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:is_obsolete ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:definition ] ;
    owl:hasKey ( hmd:primary_xref ) ;
    skos:definition "一个生物医药概念的唯一锚点。所有别名、外部 ID、抽取事实、索引条目都挂在这个 ID 上。 ID 单调递增、永不复用；废弃走 replaced_by / consider 而不是删除。" ;
    skos:exactMatch skos:Concept ;
    skos:inScheme hmd:concept .

hmd:DecisionRecord a owl:Class ;
    rdfs:label "DecisionRecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:state_before ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:chosen ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:state_after ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:model_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:elapsed_ms ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:candidates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:trace_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:chosen ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:rule_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:stage ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:Candidate ;
            owl:onProperty hmd:candidates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:state_after ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:trace_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:stage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:rule_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:elapsed_ms ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:stage ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:trace_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:model_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:MappingJustificationEnum ;
            owl:onProperty hmd:justification ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:span_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:step_seq ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:span_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:state_before ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:step_seq ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:rule_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:state_after ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:state_before ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hmd:step_seq ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:span_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:elapsed_ms ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:chosen ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:model_id ] ;
    skos:definition "State 支柱（WHY）：一次决策的前后状态与候选集。 只记结果不记候选，就无法回答\"为什么没选那个\" —— 而这才是排障时真正要问的问题。" ;
    skos:inScheme hmd:obs .

hmd:Document a owl:Class ;
    rdfs:label "Document" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:external_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LanguageEnum ;
            owl:onProperty hmd:language ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:doc_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:published_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:retrieved_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:labels ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:DocTypeEnum ;
            owl:onProperty hmd:doc_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:doc_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:language ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:source_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:retrieved_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:published_on ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:source_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:external_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LicenseTierEnum ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:license_tier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:source_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:title ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hmd:external_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^DOC:[A-Za-z0-9._:-]+$" ] ) ] ) ] ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty hmd:published_on ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty hmd:retrieved_on ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:labels ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:title ] ;
    skos:definition "语料中的一篇文档。PoC 语料为 PubMed/PMC、ClinicalTrials.gov、专利。" ;
    skos:inScheme hmd:fact .

hmd:DocumentLabel a owl:Class ;
    rdfs:label "DocumentLabel" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:dimension ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^HMDT:[A-Z_]+:[a-z0-9_]+$" ] ) ] ) ] ;
            owl:onProperty hmd:label_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hmd:matched_keywords ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:label_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:TaxonomyDimensionEnum ;
            owl:onProperty hmd:dimension ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:MappingJustificationEnum ;
            owl:onProperty hmd:justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:justification ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^DOC:[A-Za-z0-9._:-]+$" ] ) ] ) ] ;
            owl:onProperty hmd:doc_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:justification ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:label_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:ReviewStatusEnum ;
            owl:onProperty hmd:review_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:matched_keywords ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:confidence ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:review_status ] ;
    skos:definition "一篇文档上的一条标引结果，带置信度与依据。" ;
    skos:inScheme hmd:taxonomy .

hmd:ExpandRequest a owl:Class ;
    rdfs:label "ExpandRequest" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty hmd:min_weight ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:max_depth ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hmd:include_descendants ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:top_k ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:max_depth ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty hmd:min_weight ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty hmd:top_k ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty hmd:concept_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom hmd:LanguageEnum ;
            owl:onProperty hmd:languages ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:include_descendants ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty hmd:min_weight ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
