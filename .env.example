# 复制为 .env 后按需修改。全部由 biomed_ontology.config.Settings 读取（前缀 HMD_）。
# 未列出的项使用 Settings 默认值；勿把真实密钥提交进仓库。

# --- Foundation 联调 -------------------------------------------------------
HMD_SEARCH_BACKEND=milvus
HMD_MILVUS_URI=http://localhost:19530
# HMD_MILVUS_TOKEN=
HMD_GRAPHDB_URL=http://localhost:7200
HMD_GRAPHDB_REPOSITORY=hmd
HMD_BERN2_URL=http://localhost:8888
# 本地 BERN2 并发上限（默认 2；压测可临时调到 1）
# HMD_BERN2_CONCURRENCY=2
# HMD_BERN2_TIMEOUT_S=30
# 短于该长度的 chunk 不打远程 /plain（仅企业词典）
# HMD_BERN2_MIN_CHARS=8

# OpenMetadata：唯一 Admin（读写共用）
HMD_OPENMETADATA_URL=http://localhost:8585
HMD_OPENMETADATA_EMAIL=noparking188@gmail.com
HMD_OPENMETADATA_PASSWORD=Hello123456,
# HMD_OPENMETADATA_TOKEN=

# BIOS_v3（全量灌库需 ACK；已有 data/cache/bios_v3/.initialized 时 foundation:up 跳过重灌）
HMD_BIOS_LICENSE_ACK=poc
HMD_BIOS_INIT=full
HMD_BIOS_MAX_CONCEPTS=0
HMD_BIOS_BATCH_SIZE=500
# HMD_BIOS_FORCE=1          # 强制重新灌库
# HMD_BIOS_ALT_LABELS=false

# --- 检索 / 模型（可选）----------------------------------------------------
# HMD_MODEL_HUB=hf
# HMD_MODEL_CACHE_DIR=data/cache/models
# HMD_MILVUS_COLLECTION=hmd_chunks

# --- 版面解析 / Document Router --------------------------------------------
# auto | pymupdf4llm | docling | mineru
# HMD_LAYOUT_BACKEND=auto
# 失败或 degraded 时是否按链降级（pymupdf4llm → docling → mineru）
# HMD_LAYOUT_FALLBACK=false
# Fast Path（简单 PDF）probe 阈值
# HMD_PARSE_FAST_MAX_PAGES=40
# HMD_PARSE_FAST_MAX_IMAGES=8
# HMD_PARSE_FAST_MAX_TABLES=4
# 文档攻击面上限（页数 / 字节）
# HMD_PARSE_MAX_PAGES=400
# HMD_PARSE_MAX_BYTES=67108864

# --- MinerU Hard Path ------------------------------------------------------
# local（默认，import mineru）| http（mineru-api / 云）
# HMD_MINERU_TRANSPORT=local
# HTTP 模式才需要：
# HMD_MINERU_BASE_URL=http://localhost:8000
# HMD_MINERU_API_KEY=
# HMD_MINERU_TIMEOUT_S=300
# 引擎：pipeline | hybrid-engine | vlm-engine | …
# HMD_MINERU_ENGINE=pipeline
# auto | txt | ocr
# HMD_MINERU_PARSE_METHOD=auto
# HMD_MINERU_LANG=ch
# HMD_MINERU_FORMULA_ENABLE=true
# HMD_MINERU_TABLE_ENABLE=true
# hybrid 专用：medium | high
# HMD_MINERU_EFFORT=medium

# --- 视觉融合（可选）------------------------------------------------------
# HMD_VISION_PROVIDER=null
# HMD_VISION_MODEL=gpt-4o-mini
# HMD_VISION_BASE_URL=
# HMD_VISION_API_KEY=
# HMD_VISION_CACHE_DIR=data/cache/vision

# --- Knowledge Extraction / 文本 LLM ---------------------------------------
# 默认：DeepSeek 官方 API + deepseek-v4-flash（OpenAI-compatible）
# 未设置 API key 时自动回落 null，仅规则旁路抽取（离线可跑）
HMD_LLM_PROVIDER=deepseek
HMD_LLM_MODEL=deepseek-v4-flash
HMD_LLM_BASE_URL=https://api.deepseek.com
# HMD_LLM_API_KEY=
# HMD_LLM_CACHE_DIR=data/cache/llm
# HMD_LLM_TIMEOUT_S=60
# V4 默认 thinking；关系抽取要稳定 JSON，默认关闭
# HMD_LLM_THINKING=false
# 规则旁路（与 LLM 并行）；LLM 不可用时会自动开启
# HMD_EXTRACT_RULE_BOOST=false
# HMD_EXTRACT_MAX_PAIRS=32
# HMD_EXTRACT_MIN_CONFIDENCE=0.55
# HMD_EXTRACT_MAX_CONFIDENCE=0.85
# 其它兼容端（改 provider + base_url + model）：
# HMD_LLM_PROVIDER=openai
# HMD_LLM_BASE_URL=https://api.openai.com/v1
# HMD_LLM_MODEL=gpt-4o-mini
# HMD_LLM_PROVIDER=qwen
# HMD_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HMD_LLM_MODEL=qwen-plus
# 完全关闭 LLM：
# HMD_LLM_PROVIDER=null

# --- 观测入湖（Redpanda → Iceberg Connect Sink）-----------------------------
# HMD_OBS_EVENTS_ENABLED=true              # false=不 produce / 不写 WAL
# 默认 127.0.0.1:19092（避免 macOS localhost→::1）；设空=仅 WAL
HMD_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
# HMD_KAFKA_OBS_TOOL_IO_TOPIC=hmd.obs.tool_io
# HMD_KAFKA_ER_OBSERVATIONS_TOPIC=hmd.er.observations
# HMD_OBS_WAL_DIR=data/obs_wal

# --- Zingg 预计算模糊 ER ----------------------------------------------------
# HMD_ZINGG_MIN_SCORE=0.8
# HMD_ZINGG_WINDOW_DAYS=30
# HMD_ZINGG_MIN_OCCURRENCES=1
# HMD_ZINGG_OBSERVATIONS=all               # lake | bootstrap | all
# HMD_ZINGG_SKIP_DOCKER=false              # true=zingg-run full 走 stub-link

# --- Data Loop / evolve-mine -----------------------------------------------
# HMD_EVOLVE_INCLUDE_LAKE=false            # true=默认合并 er_observations

# --- 安全闸门 ----------------------------------------------------------------
# 凭据头信任：默认关闭，勿在生产放宽
# HMD_TRUST_ENTITLEMENT_HEADER=false
# pending 组件（BiomedCLIP / PyMuPDF4LLM / Docling / MinerU）：PoC 默认放行（Settings=true），
# 启动会告警。生产务必显式关闭：
# HMD_ACCEPT_UNCLEARED_COMPONENTS=false
